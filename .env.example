# Vorlage: kopiere diese Datei zu ".env" und trage deine eigenen Werte ein.
# Die echte .env steht in .gitignore und landet nie im Repository.

# Aus https://developers.pinterest.com -> My Apps -> deine App
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=

# Muss EXAKT so auch in den Pinterest-App-Einstellungen als Redirect URI stehen
PINTEREST_REDIRECT_URI=http://localhost:8000/auth/callback

# Zufälliger String zum Signieren des Session-Cookies. Erzeugen mit:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# Optional: echte Produkte von eBay (kostenlos, https://developer.ebay.com -> Application Keys,
# "Production"-Schlüssel). Ohne diese Werte zeigt der Shop die Beispielprodukte.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# EBAY_DE (Standard) oder EBAY_AT
EBAY_MARKETPLACE=EBAY_DE
# Optional: eBay-Partnerprogramm (EPN) -> Partnerlinks, dann als "Werbung" gekennzeichnet
EBAY_EPN_CAMPAIGN_ID=

# Optional: echte Produkte von Etsy (kostenlos, Etsy muss die App freigeben:
# https://www.etsy.com/developers -> Your Apps). Keystring und Shared Secret.
ETSY_API_KEY=
ETSY_SHARED_SECRET=

# Öffentlicher Server: 1 = jede Person bekommt eigene, getrennte Daten (anonymes Cookie).
# Lokal leer lassen – dann gibt es nur eine Person ("local"), wie bisher.
MULTI_USER=

# Optional: AliExpress-Partnerprogramm (portals.aliexpress.com) + App auf der Open Platform
# (openservice.aliexpress.com). Nur markenlose Teile – Angebote mit Markennamen werden gefiltert.
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
ALIEXPRESS_TRACKING_ID=
# Lieferland für Preise/Versand (AT, DE, …)
ALIEXPRESS_SHIP_TO=AT
