# Vorlage: kopiere diese Datei zu ".env" und trage deine eigenen Werte ein.
# Die echte .env steht in .gitignore und landet nie im Repository.

# Aus https://developers.pinterest.com -> My Apps -> deine App
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=

# Muss EXAKT so auch in den Pinterest-App-Einstellungen als Redirect URI stehen
PINTEREST_REDIRECT_URI=http://localhost:8000/auth/callback

# Zufälliger String zum Signieren des Session-Cookies. Erzeugen mit:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=
